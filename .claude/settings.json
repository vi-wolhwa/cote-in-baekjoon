{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_FUNCTION_HOOKS": "1"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(format c:*)",
      "Bash(del /s /q c:\\*)",
      "PowerShell(Remove-Item -Recurse -Force C:\\)",
      "PowerShell(Remove-Item -Recurse -Force C:\\*)",
      "PowerShell(Format-Volume*)"
    ]
  }
}
